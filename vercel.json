{
  "rewrites": [
    {
      "source": "/blog/:match*",
      "destination": "https://www.geminfinity.co.in/blog/:match*"
    },
    {
      "source": "/wp-content/:match*",
      "destination": "https://www.geminfinity.co.in/wp-content/:match*"
    },
    {
      "source": "/wp-includes/:match*",
      "destination": "https://www.geminfinity.co.in/wp-includes/:match*"
    },
    {
      "source": "/((?!blog|wp-content|wp-includes|wp-admin|wp-json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
